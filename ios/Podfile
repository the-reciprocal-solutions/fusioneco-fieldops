# CocoaPods is here for the plugins that ship no Swift package: fe_ar (Filament
# is a pod, packages/fe_ar/README.md), google_mlkit_text_recognition,
# sqflite_sqlcipher and flutter_secure_storage. Every other plugin builds with
# Swift Package Manager (FlutterGeneratedPluginSwiftPackage); Flutter mixes the
# two. Based on Flutter 3.47.5's templates/cocoapods/Podfile-ios; changes are
# marked "FieldOps". CI: docs/ios-testflight.md.

# FieldOps: 15.5, not Flutter's 15.0. GoogleMLKit/TextRecognition 9 and
# MLKitVision 10 (google_mlkit_text_recognition 0.17.1) require iOS 15.5, and
# `pod install` refuses them under a lower platform. The Runner target's
# IPHONEOS_DEPLOYMENT_TARGET matches (project.pbxproj).
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # FieldOps: every pod builds for the app's minimum (some pods declare
      # 9.0/11.0, which current Xcode no longer accepts).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      # FieldOps: resource bundles (fe_ar's fe_ar_assets with the .filamat
      # materials) must not be signed on their own; since Xcode 14 they
      # otherwise ask for a development team and fail the CI archive.
      if target.respond_to?(:product_type) && target.product_type == 'com.apple.product-type.bundle'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      end
      # FieldOps: permission_handler_apple compiles only the permissions
      # enabled here. It normally builds through Swift Package Manager, where
      # it derives these from Info.plist's usage strings instead; this block
      # only matters if SwiftPM is ever turned off. Keep it in step with the
      # NS*UsageDescription keys in Runner/Info.plist (ITMS-90683).
      if target.name == 'permission_handler_apple'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
          'PERMISSION_CAMERA=1',
          'PERMISSION_MICROPHONE=1',
          'PERMISSION_LOCATION_WHENINUSE=1',
          'PERMISSION_PHOTOS=1',
          'PERMISSION_NOTIFICATIONS=1',
        ]
      end
    end
  end
end
